# Variáveis de ambiente — copie para `.env.local` (dev) ou configure no Vercel.
# Nunca comite o `.env.local` real — só este `.env.example`.

# ─── Anthropic (LLM do diagnóstico) ───────────────────────────────────────
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Upstash Redis (rate-limit, cap diário, email gate) ───────────────────
# Crie um banco em https://upstash.com (free tier: 10k cmd/dia, sobra)
# Use a REST URL e o REST Token, não a URL de TCP.
UPSTASH_REDIS_URL=https://us1-xxx.upstash.io
UPSTASH_REDIS_TOKEN=AY...

# ─── Telegram (notificação grátis — RECOMENDADO) ──────────────────────────
# 1. No Telegram, mande mensagem pra @BotFather, /newbot, segue o passo-a-passo.
#    Ele te dá um TOKEN do tipo 1234567890:AAA-bbbb...
# 2. Pega seu chat ID mandando /start pra @userinfobot — ele responde com o ID.
TELEGRAM_BOT_TOKEN=1234567890:AAA-bbbb...
TELEGRAM_CHAT_ID=123456789

# ─── Z-API (notificação WhatsApp — OPCIONAL, pago) ────────────────────────
# Só preencha se quiser receber notificação no WhatsApp ADEMAIS do Telegram.
# Crie uma instância em https://z-api.io e conecte seu número.
ZAPI_INSTANCE_ID=3D...
ZAPI_TOKEN=ABC...
# Opcional, mas algumas contas exigem:
ZAPI_CLIENT_TOKEN=

# Seu número, formato 55DDDNUMERO. Ex: 5511987654321
FOUNDER_WHATSAPP=5511987654321
